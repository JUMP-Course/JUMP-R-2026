# ---- 0. 加载包 ----
library(dplyr)
library(ggplot2)
library(broom)    
library(tidyr)    

# ---- 1. 准备分层变量（确保是因子，且无缺失） ----
# 年龄二分类（50-64岁 / ≥65岁）
data_new$age_group2 <- ifelse(data_new$年龄 < 65, "50-64岁", "≥65岁")
data_new$age_group2 <- factor(data_new$age_group2, levels = c("50-64岁", "≥65岁"))

# BMI 三分类（正常 <24 / 超重 24~28 / 肥胖 ≥28）
data_new$bmi_group3 <- cut(data_new$BMI,
                           breaks = c(-Inf, 24, 28, Inf),
                           labels = c("正常 (<24)", "超重 (24~28)", "肥胖 (≥28)"),
                           right = FALSE)


# ---- 2. 定义全模型公式（用连续睡眠时间） ----
full_formula_cont <- as.formula(
  高血压 ~ 睡眠时间 + 年龄 + 性别 + 城乡 + 教育 + 吸烟 + 饮酒 + BMI + 
    总收入 + 医疗保险 + 婚姻
)

# ---- 3. 亚组分析：分别在每个亚组中拟合全模型 ----
# 定义亚组列表
subgroup_defs <- list(
  "性别_男" = list(data = data_new[data_new$性别 == "男", ], 
                drop_vars = c("性别")),
  "性别_女" = list(data = data_new[data_new$性别 == "女", ], 
                drop_vars = c("性别")),
  "年龄_50-64岁" = list(data = data_new[data_new$age_group2 == "50-64岁", ], 
                     drop_vars = c("age_group2")),
  "年龄_≥65岁" = list(data = data_new[data_new$age_group2 == "≥65岁", ], 
                   drop_vars = c("age_group2")),
  "BMI_正常" = list(data = data_new[data_new$bmi_group3 == "正常 (<24)", ], 
                  drop_vars = c("bmi_group3")),
  "BMI_超重" = list(data = data_new[data_new$bmi_group3 == "超重 (24~28)", ], 
                  drop_vars = c("bmi_group3")),
  "BMI_肥胖" = list(data = data_new[data_new$bmi_group3 == "肥胖 (≥28)", ], 
                  drop_vars = c("bmi_group3")),
  "城乡_农村" = list(data = data_new[data_new$城乡 == "农村", ], 
                 drop_vars = c("城乡")),
  "城乡_城镇" = list(data = data_new[data_new$城乡 == "城镇", ], 
                 drop_vars = c("城乡"))
)

# 存储结果
subgroup_results <- list()

for (name in names(subgroup_defs)) {
  sub_data <- subgroup_defs[[name]]$data
  drop_vars <- subgroup_defs[[name]]$drop_vars
  
  # 跳过样本量太小的亚组
  if (nrow(sub_data) < 50) {
    cat("跳过亚组：", name, "，样本量仅", nrow(sub_data), "\n")
    next
  }
  
  vars_in_formula <- all.vars(full_formula_cont)
  vars_to_keep <- vars_in_formula[!vars_in_formula %in% drop_vars]
  formula_sub <- as.formula(paste("高血压 ~", paste(vars_to_keep, collapse = " + ")))
  
  # 拟合模型
  fit_sub <- tryCatch({
    glm(formula_sub, data = sub_data, family = binomial)
  }, error = function(e) {
    cat("亚组", name, "拟合失败：", e$message, "\n")
    return(NULL)
  })
  
  if (is.null(fit_sub)) next
  
  # 提取睡眠时间的 OR 和 CI
  coef_summary <- summary(fit_sub)$coefficients
  if (!"睡眠时间" %in% rownames(coef_summary)) {
    cat("亚组", name, "中未找到睡眠时间变量\n")
    next
  }
  
  beta <- coef_summary["睡眠时间", "Estimate"]
  se <- coef_summary["睡眠时间", "Std. Error"]
  p_val <- coef_summary["睡眠时间", "Pr(>|z|)"]
  or <- exp(beta)
  or_lower <- exp(beta - 1.96 * se)
  or_upper <- exp(beta + 1.96 * se)
  
  subgroup_results[[name]] <- data.frame(
    亚组 = name,
    N = nrow(sub_data),
    OR = or,
    OR_lower = or_lower,
    OR_upper = or_upper,
    P_value = p_val
  )
}

# 合并所有亚组结果
subgroup_df <- do.call(rbind, subgroup_results)
# 按亚组类型提取分组名称（用于排序）
subgroup_df$亚组类型 <- gsub("_.*", "", subgroup_df$亚组)
subgroup_df$亚组标签 <- gsub(".*_", "", subgroup_df$亚组)

