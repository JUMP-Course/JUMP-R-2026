# 14. 限制性立方样条（RCS）—— 剂量-反应关系分析
# ============================================================================

# ---- 14.1 加载包 ----
library(rms)      
library(ggplot2)  

# ---- 14.2 检查数据框和变量 ----
# 确保所有分类变量都是因子
factor_vars <- c("性别", "城乡", "教育", "吸烟", "饮酒", "医疗保险", "婚姻")
for (var in factor_vars) {
  if (var %in% names(data_new) && !is.factor(data_new[[var]])) {
    data_new[[var]] <- as.factor(data_new[[var]])
  }
}

# 输出各因子水平
cat("=== 各分类变量水平 ===\n")
for (var in factor_vars) {
  if (var %in% names(data_new) && is.factor(data_new[[var]])) {
    cat(var, ":", paste(levels(data_new[[var]]), collapse = " | "), "\n")
  }
}

# ---- 14.3 定义节点 ----
# 使用 4 个节点：第 5、35、65、95 百分位
knots <- quantile(data_new$睡眠时间, probs = c(0.05, 0.35, 0.65, 0.95), na.rm = TRUE)
cat("节点位置：", round(knots, 2))

# ---- 4. 拟合 RCS 模型----
rcs_glm <- glm(
  高血压 ~ rcs(睡眠时间, knots) + 年龄 + 性别 + 城乡 + 教育 + 吸烟 + 饮酒 + BMI + 
    总收入 + 医疗保险 + 婚姻,
  data = data_new,
  family = binomial
)

# ---- 5. 非线性趋势检验 ----
linear_glm <- glm(
  高血压 ~ 睡眠时间 + 年龄 + 性别 + 城乡 + 教育 + 吸烟 + 饮酒 + BMI + 
    总收入 + 医疗保险 + 婚姻,
  data = data_new,
  family = binomial
)
lrt_result <- anova(linear_glm, rcs_glm, test = "LRT")
cat("=== 非线性趋势检验（似然比检验） ===\n")
print(lrt_result)
# 提取 P 值
p_nonlinear <- lrt_result[["Pr(>Chi)"]][2]
cat("\n非线性检验 P 值：", p_nonlinear, "\n")
if (!is.na(p_nonlinear) && p_nonlinear < 0.05) {
  cat("结论：睡眠时长与高血压存在显著的非线性关系（U型或J型）。\n\n")
} else {
  cat("结论：未检测到显著的非线性关系，可能为线性趋势。\n\n")
}

# ---- 6. 构建预测数据框 ----
# 生成睡眠时间序列
sleep_seq <- seq(2, 14, by = 0.1)

# 预测数据框：所有分类变量取第一个水平（即参照组），连续变量取中位数
pred_data <- expand.grid(
  睡眠时间 = sleep_seq,
  年龄 = median(data_new$年龄, na.rm = TRUE),
  性别 = levels(data_new$性别)[1],
  城乡 = levels(data_new$城乡)[1],
  教育 = 1,  
  吸烟 = levels(data_new$吸烟)[1],
  饮酒 = levels(data_new$饮酒)[1],
  BMI = median(data_new$BMI, na.rm = TRUE),
  总收入 = median(data_new$总收入, na.rm = TRUE),
  医疗保险 = levels(data_new$医疗保险)[1],
  婚姻 = 1
)

# 强制转换因子列，确保与模型中的因子水平一致
for (var in c("性别", "城乡", "吸烟", "饮酒", "医疗保险")) {
  if (var %in% names(pred_data) && is.factor(data_new[[var]])) {
    pred_data[[var]] <- factor(pred_data[[var]], levels = levels(data_new[[var]]))
  }
}

if ("教育" %in% names(pred_data) && is.factor(data_new$教育)) {
  pred_data$教育 <- factor(pred_data$教育, levels = levels(data_new$教育))
}
if ("婚姻" %in% names(pred_data) && is.factor(data_new$婚姻)) {
  pred_data$婚姻 <- factor(pred_data$婚姻, levels = levels(data_new$婚姻))
}

# ---- 7. 预测 log-OR ----
pred <- predict(rcs_glm, newdata = pred_data, se.fit = TRUE)
log_or <- pred$fit
se_log_or <- pred$se.fit

# ---- 8. 以 7 小时为参照，计算相对 OR ----
ref_idx <- which.min(abs(pred_data$睡眠时间 - 7))
log_or_ref <- log_or[ref_idx]  # 7 小时的 log-OR（相对于截距）

# 计算相对 OR 和 95% CI
or_rel <- exp(log_or - log_or_ref)
or_rel_lower <- exp(log_or - log_or_ref - 1.96 * se_log_or)
or_rel_upper <- exp(log_or - log_or_ref + 1.96 * se_log_or)

plot_data <- data.frame(
  睡眠时间 = sleep_seq,
  OR = or_rel,
  OR_lower = or_rel_lower,
  OR_upper = or_rel_upper
)

# ---- 9. 查看预测结果 ----
cat("=== 预测结果（以7小时为参照） ===\n")
print(head(plot_data, 10))

# ---- 10. 找出最低风险点----
ref_point <- plot_data$睡眠时间[which.min(abs(plot_data$OR - 1))]
cat("\n最低风险点（OR≈1）对应的睡眠时长：", round(ref_point, 2), "小时\n")

# ---- 11. 绘制 RCS 曲线 ----
p_rcs <- ggplot(plot_data, aes(x = 睡眠时间, y = OR)) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "gray50") +
  geom_ribbon(aes(ymin = OR_lower, ymax = OR_upper), 
              alpha = 0.2, fill = "steelblue") +
