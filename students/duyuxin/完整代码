library(corrplot)

# 确保 num_vars 只包含数值列
num_vars <- data.frame(
  年龄 = data_new$年龄,
  睡眠时间 = data_new$睡眠时间,
  BMI = data_new$BMI,
  总收入 = data_new$总收入,
  高血压 = as.numeric(data_new$高血压 == "高血压")
)

# 计算 Spearman 相关系数
cor_matrix <- cor(num_vars, method = "spearman", use = "complete.obs")

# 绘制热图
png("补充图_相关性热图.png", width = 800, height = 800, res = 120)
corrplot(cor_matrix, 
         method = "color", 
         type = "upper", 
         addCoef.col = "black", 
         number.cex = 1.0,
         tl.col = "black", 
         tl.srt = 45,
         title = "核心变量Spearman相关系数矩阵", 
         mar = c(0, 0, 2, 0))
